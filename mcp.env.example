# Environment overrides for the MCP server (mcp_server.py).
# Copy to .env or set in your MCP client's env block. All optional —
# defaults are used when unset.

# Run scrapes headless (no visible browser). Default: true for agents.
IRS_HEADLESS=true

# Parallel worker browser windows (1-8). Default: 2
IRS_WORKERS=2

# Delay in seconds between reel requests (rate-limit cushion). Default: 1
IRS_DELAY=1

# Auto-fetch each owner's profile for followers count after reels. Default: true
IRS_WITH_PROFILES=true
